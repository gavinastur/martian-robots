{
  "name": "martian-robots",
  "version": "0.0.1",
  "description": "A program that determines each sequence of robot positions and reports the final position of the robot.",
  "author": "Gavin Astur",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:gavinastur/martian-robots.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.12.4",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "typescript": "6.0.3",
    "tsx": "4.22.3",
    "vitest": "4.1.7"
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "npm run tsc",
    "index": "tsx src/index.ts",
    "lint": "npm run biome:check:fix",
    "biome:check:fix": "biome check --write .",
    "test": "vitest run --coverage",
    "tsc": "tsc"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
